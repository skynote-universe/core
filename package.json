{
  "name": "@skynote/core",
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "SkyNote platform-neutral in-memory canvas kernel & standard protocols",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skynote-universe/core.git"
  },
  "homepage": "https://github.com/skynote-universe/core#readme",
  "bugs": {
    "url": "https://github.com/skynote-universe/core/issues"
  },
  "keywords": [
    "whiteboard",
    "infinite-canvas",
    "canvas",
    "crdt-ready",
    "platform-neutral"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit",
    "bench": "vitest run --dir bench",
    "lint": "eslint ."
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./protocols": {
      "types": "./src/protocols/index.ts",
      "import": "./src/protocols/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    },
    "./operation": {
      "types": "./src/operation/index.ts",
      "import": "./src/operation/index.ts"
    },
    "./state": {
      "types": "./src/state/index.ts",
      "import": "./src/state/index.ts"
    },
    "./registry": {
      "types": "./src/registry/index.ts",
      "import": "./src/registry/index.ts"
    },
    "./spatial": {
      "types": "./src/spatial/index.ts",
      "import": "./src/spatial/index.ts"
    },
    "./input": {
      "types": "./src/input/index.ts",
      "import": "./src/input/index.ts"
    },
    "./plugin": {
      "types": "./src/plugin/index.ts",
      "import": "./src/plugin/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./protocols": {
        "types": "./dist/protocols.d.ts",
        "import": "./dist/protocols.js"
      },
      "./utils": {
        "types": "./dist/utils.d.ts",
        "import": "./dist/utils.js"
      },
      "./operation": {
        "types": "./dist/operation.d.ts",
        "import": "./dist/operation.js"
      },
      "./state": {
        "types": "./dist/state.d.ts",
        "import": "./dist/state.js"
      },
      "./registry": {
        "types": "./dist/registry.d.ts",
        "import": "./dist/registry.js"
      },
      "./spatial": {
        "types": "./dist/spatial.d.ts",
        "import": "./dist/spatial.js"
      },
      "./input": {
        "types": "./dist/input.d.ts",
        "import": "./dist/input.js"
      },
      "./plugin": {
        "types": "./dist/plugin.d.ts",
        "import": "./dist/plugin.js"
      }
    }
  }
}
