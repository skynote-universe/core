{
  "name": "@skynote/core",
  "version": "0.1.0",
  "type": "module",
  "description": "SkyNote platform-neutral in-memory canvas kernel & standard protocols",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
