{
  "name": "@skynote/core",
  "version": "0.1.0",
  "type": "module",
  "description": "SkyNote platform-neutral in-memory canvas kernel & standard protocols",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit",
    "bench": "vitest run --dir bench"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./protocols": {
      "types": "./src/protocols/index.ts",
      "import": "./src/protocols/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    },
    "./operation": {
      "types": "./src/operation/index.ts",
      "import": "./src/operation/index.ts"
    },
    "./state": {
      "types": "./src/state/index.ts",
      "import": "./src/state/index.ts"
    },
    "./registry": {
      "types": "./src/registry/index.ts",
      "import": "./src/registry/index.ts"
    },
    "./spatial": {
      "types": "./src/spatial/index.ts",
      "import": "./src/spatial/index.ts"
    },
    "./input": {
      "types": "./src/input/index.ts",
      "import": "./src/input/index.ts"
    },
    "./plugin": {
      "types": "./src/plugin/index.ts",
      "import": "./src/plugin/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
